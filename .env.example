# Copy to .env and fill in real values:  cp .env.example .env
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Never commit .env.

# Public port of the gateway (http://localhost:8080)
APP_PORT=8080

# ---- Postgres (shared by server and ws) ----
POSTGRES_DB=bark
POSTGRES_USER=bark
POSTGRES_PASSWORD=change-me

# ---- Django (loaded by server/config/Config.py) ----
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_WSGI_MODULE=server.wsgi
DJANGO_MIGRATE_ON_START=1
GUNICORN_WORKERS=3

# ---- JWT (must be identical for server and ws) ----
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=bark-server
JWT_AUDIENCE=bark-web
JWT_ACCESS_COOKIE=access_token

# ---- Websocket service ----
# Only these origins may open a socket (the Next.js frontend).
WS_ALLOWED_ORIGINS=http://localhost:8080
