# Copy to .env and fill in real values:  cp .env.example .env
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Never commit .env.

# ---- Ports ----
# Public port of the gateway: open the site at http://localhost:8080. The only port published
# on your machine; everything below is reached through it.
APP_PORT=8080
# Port the Next.js web app listens on inside Docker (the gateway forwards / to it).
WEB_PORT=3000

# ---- Postgres (shared by server and ws) ----
POSTGRES_DB=bark
POSTGRES_USER=bark
POSTGRES_PASSWORD=change-me

# ---- Django (loaded by server/config/Config.py) ----
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
# Production sets both to 1 only behind the trusted private gateway.
DJANGO_TRUST_PROXY=0
DJANGO_SECURE_COOKIES=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Browser origins allowed to call /api/ cross-origin (the web frontend), comma-separated.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080
DJANGO_WSGI_MODULE=server.wsgi
DJANGO_MIGRATE_ON_START=1
GUNICORN_WORKERS=3

# ---- JWT (must be identical for server and ws) ----
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=bark-server
JWT_AUDIENCE=bark-web
JWT_ACCESS_COOKIE=access_token
# How long a login lasts. 10080 minutes = 1 week.
JWT_ACCESS_TTL_MINUTES=10080
# 1 = cookie only sent over HTTPS (and http://localhost). Set 0 only for plain-http testing.
JWT_COOKIE_SECURE=1

# ---- Login brute-force protection (server) ----
# After this many wrong passwords, the account is locked for LOGIN_LOCKOUT_MINUTES.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# ---- Canvas / game library (server) ----
# Requests per user per minute across /api/canvas/.
CANVAS_REQUESTS_PER_MINUTE=300

# ---- Byte coding hints (Django only; never NEXT_PUBLIC) ----
BYTE_HINTS_ENABLED=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17

# ---- Byte voice (Django only; never NEXT_PUBLIC) ----
# Add an ElevenLabs key with Text to Speech access and access to this voice.
BYTE_VOICE_ENABLED=1
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=n7Wi4g1bhpw4Bs8HK5ph
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ---- Password / username recovery (server) ----
FRONTEND_URL=http://localhost:8080
PASSWORD_RESET_MINUTES=60
ACCOUNT_RECOVERY_ENABLED=1
# This frontend value is embedded at build time. Production builds set it to 0.
NEXT_PUBLIC_ACCOUNT_RECOVERY_ENABLED=1
# Demo mode: emails are saved and shown by GET /api/auth/demo-inbox/ instead of being sent.
# Anyone who knows an address can read its inbox; set 0 for anything real.
DEMO_EMAIL=1
# Used only when DEMO_EMAIL=0. Console backend prints emails to `docker compose logs server`. For real email use
# django.core.mail.backends.smtp.EmailBackend and set EMAIL_HOST/PORT/HOST_USER/HOST_PASSWORD.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Bark <no-reply@localhost>

# ---- Websocket service ----
# Only these origins may open a socket. Add http://127.0.0.1:5174 in development to let the
# Vite Script Lab connect; never ship that entry.
WS_ALLOWED_ORIGINS=http://localhost:8080

# ---- Collaboration (ws) ----
# Cross-worker fan-out. Leave empty to use the in-process bus (single uvicorn worker).
REDIS_URL=redis://redis:6379/0
# Canvas workspace tables are migrated by Django, before socket workers start.
# Legacy standalone collab_* tables are not migrated or exposed by the service.
WS_AUTO_MIGRATE=0
# Seconds a lock survives without a heartbeat. Live locks are never stolen.
WS_LOCK_TTL=30
WS_MAX_OPS_PER_COMMIT=64
WS_MAX_BLOCK_DEPTH=64
WS_RATE_COMMITS=30
WS_RATE_LOCKS=10
WS_SEND_QUEUE_MAX=256
WS_SNAPSHOT_EVERY=200
