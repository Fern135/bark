{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prepare:editor": "node scripts/prepare-editor.mjs && node scripts/copy-game-assets.mjs",
    "predev": "npm run prepare:editor",
    "prebuild": "npm run prepare:editor",
