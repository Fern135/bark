    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "axios": "^1.20.0",
    "blockly": "^13.3.0",
    "bootstrap": "^5.3.8",
    "codemirror": "^6.0.2",
    "motion": "^13.4.4",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
